{
  "name": "full",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && vite build --mode native-fake",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=native",
    "predocs:screenshots": "npm run build",
    "docs:screenshots": "playwright test --project=screenshots --workers=1",
    "pretest:perf": "npm run build",
    "test:perf": "playwright test --project=performance --workers=1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/kit": "^7.23.0",
    "@milkdown/transformer": "^7.23.0",
    "@tanstack/react-virtual": "^3.14.26",
    "codemirror": "^6.0.2",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@codemirror/search": "^6.7.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
