{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "full",
  "version": "../package.json",
  "identifier": "com.marcos-a.full",
  "build": {
    "beforeDevCommand": "npx vite --mode desktop --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run desktop:frontend",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "full",
        "width": 1100,
        "height": 750,
        "minWidth": 768,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "contentTypes": ["net.daringfireball.markdown"],
        "name": "Markdown document",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": ["csv"],
        "contentTypes": ["public.comma-separated-values-text"],
        "name": "CSV document",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": ["txt"],
        "name": "Text document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [],
        "contentTypes": ["public.text"],
        "name": "Other text document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "15.0",
      "files": {
        "Resources/document-markdown.icns": "icons/document-markdown.icns",
        "Resources/document-csv.icns": "icons/document-csv.icns",
        "Resources/document-text.icns": "icons/document-text.icns",
        "Resources/document-plain.icns": "icons/document-plain.icns"
      }
    }
  }
}
